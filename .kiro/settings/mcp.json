{
  "mcpServers": {
    "schemaseance": {
      "command": "node",
      "args": ["mcp/dist/index.js"],
      "env": {
        "SCHEMASEANCE_ENGINE": "./engine/cmd/cli/schemaseance"
      },
      "disabled": false
    },
    "vercel": {
      "command": "npx",
      "args": ["mcp-remote", "https://mcp.vercel.com"]
    }
  }
}
